        <li><a href="https://x.com/web_nari_selfs" target="_blank" rel="noopener" class="site-footer__social-link"><img src="images/icon-x.svg" alt="" aria-hidden="true" class="icon-slot icon-slot--social icon-slot--social-muted">X</a></li>
        <li><a href="https://note.com/barina_ccm" target="_blank" rel="noopener" class="site-footer__social-link"><img src="images/icon-note.svg" alt="" aria-hidden="true" class="icon-slot icon-slot--social icon-slot--social-muted">note</a></li>

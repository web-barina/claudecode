<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { entered: false };
  renderVals() {
    const e = this.state.entered;
    return {
      enter: () => this.setState({ entered: true }),
      gateStyle:
        "position:fixed;top:0;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,430px);z-index:50;background:#0B0B0C;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:clamp(24px,6cqw,80px);" +
        "transition:opacity .9s ease,visibility .9s ease;" +
        (e ? "opacity:0;visibility:hidden;pointer-events:none" : "opacity:1;visibility:visible"),
      pageStyle: e
        ? "animation:slowfade 1.2s ease both"
        : "opacity:0;height:100svh;overflow:hidden"
    };
  }
}

</script>

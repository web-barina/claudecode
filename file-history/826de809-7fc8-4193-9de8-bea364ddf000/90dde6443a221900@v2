# sanity: no duplicate keys, no key is a substring collision risk (all distinct tokens)
assert len(MAP) == len(set(MAP.keys()))

for fname in FILES:
    path = BASE + fname
    text = open(path, encoding="utf-8").read()
    def repl(m):
        old = m.group(1)
        new = MAP.get(old, old)
        return f'class="{new}"'
    new_text = re.sub(r'class="([a-zA-Z0-9-]+)"', repl, text)
    open(path, "w", encoding="utf-8").write(new_text)
    missed = set(re.findall(r'class="([a-zA-Z0-9-]+)"', new_text)) - set(MAP.values()) - {v for vv in MAP.values() for v in vv.split()}
    # only report tokens that look like our old auto-generated pattern and weren't remapped
    leftover_old = [t for t in missed if re.match(r'^(base|nav|main|first|about|what|strength|works|process|career|next|contact|form|fieldset|footer|header|error)-?\d*$', t) and t in MAP]
    print(fname, "done. unresolved-old-pattern-classes:", leftover_old)

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ワイヤーフレーム｜TOPページ</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Noto Sans JP', sans-serif; color: #333333; background: #FFFFFF; font-size: 12px; line-height: 1.7; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .label { display:inline-block; font-size:10px; color:#888888; border:1px solid #DDDDDD; padding:2px 8px; margin-bottom:8px; }
  .img-ph { background:#CCCCCC; border-radius:0; display:flex; align-items:center; justify-content:center; color:#666666; font-size:12px; width:100%; }
  .icon-ph { background:#CCCCCC; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#666666; font-size:10px; flex-shrink:0; }
  .btn { display:inline-block; background:#888888; color:#FFFFFF; text-align:center; padding:12px 24px; font-size:13px; font-weight:700; border:none; cursor:pointer; }
  .btn-block { display:block; width:100%; }
  .section { padding: 32px 0; border-bottom: 1px solid #DDDDDD; }
  .section-inner { padding: 0 16px; }
  .section-title { font-size: 18px; font-weight: 700; text-align:center; margin-bottom: 8px; }
  .section-lead { font-size: 12px; text-align:center; color:#666666; margin-bottom:24px; }
  .header { border-bottom:1px solid #DDDDDD; }
  .header-inner { max-width:1200px; margin:0 auto; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; }
  .logo-ph { background:#CCCCCC; width:120px; height:32px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#666; }
  .nav-icon { width:32px; height:32px; }
  .nav-pc { display:none; }
  .header-btn { display:none; }

  .hero-img { height:220px; }
  .hero-text { padding:24px 16px; text-align:center; }
  .hero-copy-label { font-size:12px; color:#666; margin-bottom:8px; }
  .hero-title { font-size:20px; font-weight:700; margin-bottom:12px; }
  .hero-sub { font-size:12px; color:#555; margin-bottom:16px; }

  .promo { border:2px solid #888888; margin:16px; padding:16px; text-align:center; }
  .promo-label { font-size:11px; border:1px solid #888888; display:inline-block; padding:2px 10px; margin-bottom:8px; }
  .promo-name { font-size:13px; font-weight:700; margin-bottom:4px; }
  .promo-price { font-size:28px; font-weight:700; margin-bottom:12px; }
  .promo-price span { font-size:14px; }
  .promo-note { font-size:10px; color:#888; margin-top:8px; }

  .symptom-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .symptom-card { border:1px solid #DDDDDD; padding:12px; }
  .symptom-card .icon-ph { width:36px; height:36px; margin:0 auto 8px; font-size:9px; }
  .symptom-card h4 { font-size:12px; text-align:center; font-weight:700; margin-bottom:6px; }
  .symptom-card p { font-size:11px; text-align:center; color:#666; margin-bottom:8px; }
  .symptom-card .btn { width:100%; font-size:11px; padding:8px; }

  .number-grid { display:grid; grid-template-columns: 1fr; gap:16px; text-align:center; }
  .number-box .num { font-size:36px; font-weight:700; }
  .number-box .unit { font-size:12px; }
  .number-box p { font-size:11px; color:#666; margin-top:8px; }

  .reason-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .reason-card .icon-ph { width:56px; height:56px; margin:0 auto 8px; }
  .reason-card { text-align:center; }
  .reason-card h4 { font-size:12px; margin-bottom:4px; }

  .staff-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .staff-card .img-ph { height:110px; margin-bottom:8px; }
  .staff-card h4 { font-size:12px; font-weight:700; }
  .staff-card p { font-size:11px; color:#666; }

  .ba-row { display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:12px; }
  .ba-row .img-ph { height:100px; font-size:10px; }
  .slider-nav { text-align:center; font-size:12px; color:#888; margin-top:8px; }

  .voice-grid { display:grid; grid-template-columns: 1fr; gap:12px; }
  .voice-card { border:1px solid #DDDDDD; padding:12px; }
  .voice-card .img-ph { width:48px; height:48px; border-radius:50%; margin-bottom:8px; font-size:9px; }
  .voice-card h4 { font-size:12px; font-weight:700; margin-bottom:6px; }
  .voice-card p { font-size:11px; color:#555; }

  .flow-list { display:flex; flex-direction:column; gap:12px; }
  .flow-item { display:flex; gap:12px; align-items:flex-start; border:1px solid #DDDDDD; padding:12px; }
  .flow-num { width:28px; height:28px; font-size:13px; font-weight:700; }
  .flow-item .img-ph { width:70px; height:70px; font-size:9px; flex-shrink:0; }
  .flow-item h4 { font-size:12px; font-weight:700; margin-bottom:4px; }
  .flow-item p { font-size:11px; color:#666; }

  .faq-item { border-bottom:1px solid #DDDDDD; padding:12px 0; }
  .faq-q { font-weight:700; font-size:12px; margin-bottom:6px; }
  .faq-a { font-size:11px; color:#666; }

  .store-grid { display:grid; grid-template-columns:1fr; gap:12px; }
  .store-card { border:1px solid #DDDDDD; padding:12px; display:flex; gap:12px; }
  .store-card .img-ph { width:90px; height:70px; flex-shrink:0; font-size:9px; }
  .store-card h4 { font-size:12px; font-weight:700; margin-bottom:4px; }
  .store-card p { font-size:10px; color:#666; margin-bottom:6px; }
  .store-card .btn { font-size:10px; padding:6px 10px; }

  .news-list li { display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #DDDDDD; font-size:11px; }
  .news-list .date { color:#888; flex-shrink:0; }

  .column-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .column-card .img-ph { height:80px; font-size:9px; margin-bottom:6px; }
  .column-card p { font-size:11px; }

  .source-note { font-size:10px; color:#888; border-top:1px dashed #DDDDDD; margin-top:16px; padding-top:8px; }

  footer { background:#EFEFEF; padding:24px 16px; text-align:center; }
  .footer-nav { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; font-size:11px; margin-bottom:12px; }
  .footer-copy { font-size:10px; color:#888; }

  @media (min-width: 769px) {
    body { font-size:16px; }
    .header-inner { padding:16px 40px; }
    .nav-icon { display:none; }
    .nav-pc { display:flex; gap:24px; font-size:14px; }
    .header-btn { display:block; }
    .header-btn .btn { padding:10px 20px; font-size:13px; }

    .section { padding:64px 0; }
    .section-inner { padding:0 40px; }
    .section-title { font-size:28px; }
    .section-lead { font-size:14px; margin-bottom:40px; }

    .hero-img { height:420px; }
    .hero-text { padding:40px 0; }
    .hero-title { font-size:32px; }
    .hero-sub { font-size:15px; max-width:600px; margin:0 auto 20px; }

    .promo { margin:24px auto; max-width:800px; padding:32px; display:flex; align-items:center; justify-content:space-between; text-align:left; }
    .promo-price { font-size:40px; margin-bottom:0; }
    .promo-note { margin-top:0; }

    .symptom-grid { grid-template-columns: repeat(4, 1fr); gap:16px; }
    .number-grid { grid-template-columns: repeat(3, 1fr); }
    .number-box .num { font-size:56px; }
    .reason-grid { grid-template-columns: repeat(4, 1fr); }
    .staff-grid { grid-template-columns: repeat(4, 1fr); }
    .staff-card .img-ph { height:180px; }
    .ba-row { grid-template-columns: repeat(2, 1fr); }
    .ba-row .img-ph { height:220px; }
    .voice-grid { grid-template-columns: repeat(3, 1fr); }
    .flow-list { flex-direction:row; }
    .flow-item { flex-direction:column; flex:1; text-align:center; }
    .flow-item .img-ph { width:100%; height:140px; margin:0 auto 8px; }
    .store-grid { grid-template-columns: repeat(2, 1fr); }
    .column-grid { grid-template-columns: repeat(4, 1fr); }
    .footer-nav { font-size:13px; }
  }
</style>
</head>

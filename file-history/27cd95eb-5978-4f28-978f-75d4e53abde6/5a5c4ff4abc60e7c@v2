    <div class="header-btn"><a href="#" class="btn">WEB予約</a></div>
    <div class="icon-ph nav-icon">MENU</div>
  </div>
</header>
<p class="breadcrumb wrap">TOP ＞ 店舗一覧 ＞ 白根本院</p>

<!-- 店舗ヘッダー -->
<div class="store-hero">

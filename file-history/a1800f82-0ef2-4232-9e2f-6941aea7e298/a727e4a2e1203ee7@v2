<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CMS操作マニュアル｜登記情報提供サービス</title>
<style>
  :root{
    --navy:#292f61;
    --navy-light:#8592c9;
    --teal:#0a8388;
    --teal-light:#7bb2b2;
    --gray-header:#d0d0d0;
    --gray-header-2:#c9c9c9;
    --border:#dcdde3;
    --border-soft:#ececef;
    --bg:#f5f6f9;
    --card-bg:#ffffff;
    --text:#22252f;
    --text-soft:#565a68;
    --orange:#e8622c;
    --link:#2454b8;
    --radius:10px;
    --maxw:1320px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",-apple-system,BlinkMacSystemFont,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.7;
    font-size:15px;
  }
  a{color:var(--link);}
  img{max-width:100%;display:block;}

  /* ---------- masthead ---------- */
  .masthead{
    background:linear-gradient(135deg,var(--navy),#3a4380);
    color:#fff;
    padding:36px 24px 28px;
  }
  .masthead .tag{
    display:inline-block;
    background:rgba(255,255,255,.16);
    padding:4px 12px;
    border-radius:999px;
    font-size:12px;
    letter-spacing:.05em;
    margin-bottom:10px;
  }
  .masthead h1{margin:0 0 10px;font-size:clamp(24px,4vw,34px);}
  .masthead .meta{display:flex;flex-wrap:wrap;gap:6px 22px;font-size:13px;color:#d8dcf5;}
  .masthead .meta b{color:#fff;font-weight:600;}

  /* ---------- layout ---------- */
  .layout{
    max-width:var(--maxw);
    margin:0 auto;
    display:grid;
    grid-template-columns:250px 1fr;
    gap:28px;
    padding:28px 20px 80px;
    align-items:start;
  }
  @media (max-width:900px){
    .layout{grid-template-columns:1fr;}
  }

  /* ---------- TOC ---------- */
  .toc{
    position:sticky;
    top:16px;
    background:var(--card-bg);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:14px 6px;
    max-height:calc(100vh - 32px);
    overflow-y:auto;
  }
  .toc h2{
    font-size:12px;
    letter-spacing:.08em;
    color:var(--text-soft);
    margin:4px 14px 8px;
    text-transform:uppercase;
  }
  .toc ul{list-style:none;margin:0;padding:0;}
  .toc > ul > li{margin-bottom:2px;}
  .toc a{
    display:block;
    padding:7px 14px;
    border-radius:6px;
    color:var(--text);
    text-decoration:none;
    font-size:13.5px;
  }
  .toc a:hover{background:var(--border-soft);}
  .toc a.active{background:var(--navy);color:#fff;}
  .toc .sub{list-style:none;margin:0 0 6px;padding:0 0 0 14px;}
  .toc .sub a{font-size:12.5px;color:var(--text-soft);padding:5px 12px;}
  .toc .num{
    display:inline-block;
    min-width:20px;
    font-size:11px;
    color:var(--teal);
    font-weight:700;
    margin-right:2px;
  }

  /* ---------- main content ---------- */
  main{min-width:0;}

  .section{
    background:var(--card-bg);
    border:1px solid var(--border);
    border-radius:var(--radius);
    margin-bottom:22px;
    overflow:hidden;
    scroll-margin-top:16px;
  }
  .section-head{
    background:var(--navy);
    color:#fff;
    padding:14px 22px;
    display:flex;
    align-items:baseline;
    gap:10px;
    flex-wrap:wrap;
  }
  .section-head .no{
    font-size:12px;
    font-weight:700;
    background:rgba(255,255,255,.18);
    padding:2px 9px;
    border-radius:5px;
    letter-spacing:.04em;
  }
  .section-head h2{margin:0;font-size:19px;font-weight:700;}
  .section-body{padding:22px;}

  .subsection{margin-bottom:34px;}
  .subsection:last-child{margin-bottom:0;}
  .subsection-head{
    display:flex;
    align-items:baseline;
    gap:8px;
    border-bottom:2px solid var(--teal);
    padding-bottom:6px;
    margin-bottom:16px;
    flex-wrap:wrap;
  }
  .subsection-head .no{font-size:12px;color:var(--teal);font-weight:700;}
  .subsection-head h3{margin:0;font-size:16px;}
  .subsection-head .role-badges{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap;}

  .note-block{
    background:#f4f6fb;
    border:1px solid var(--border);
    border-radius:8px;
    padding:10px 14px;
    font-size:13.5px;
    color:var(--text-soft);
    margin:0 0 16px;
  }
  .note-block strong{color:var(--text);}

  /* ---------- role badges ---------- */
  .badge{
    display:inline-block;
    font-size:11.5px;
    font-weight:700;
    padding:3px 10px;
    border-radius:5px;
    color:#fff;
    white-space:nowrap;
  }
  .badge.editor{background:#e8622c;}
  .badge.primary{background:#e8622c;}
  .badge.publisher{background:#e8622c;}
  .badge.admin{background:#e8622c;}
  .badge.common{background:#0a8388;}

  /* ---------- shot-row: image + description ---------- */
  .row{
    display:flex;
    gap:22px;
    padding:16px 0;
    border-top:1px solid var(--border-soft);
    align-items:flex-start;
  }
  .row:first-of-type{border-top:none;padding-top:0;}
  .row .shot{
    flex:0 0 46%;
    max-width:46%;
    background:#f0f1f4;
    border:1px solid var(--border);
    border-radius:8px;
    padding:6px;
  }
  .row .shot img{border-radius:4px;}
  .row .shot figcaption{
    font-size:11.5px;
    color:var(--text-soft);
    text-align:center;
    padding-top:4px;
  }
  .row .desc{flex:1;min-width:0;}
  .row .desc h4{margin:0 0 8px;font-size:14.5px;}
  .row.stack{flex-direction:column;}
  .row.stack .shot{max-width:100%;flex-basis:auto;}
  .row.no-shot .desc{flex:1;}
  @media (max-width:760px){
    .row{flex-direction:column;}
    .row .shot{max-width:100%;flex-basis:auto;}
  }

  .desc ol.callouts{margin:0 0 10px;padding-left:1.3em;}
  .desc ol.callouts > li{margin-bottom:6px;}
  .desc ul.plain{margin:0 0 10px;padding-left:1.3em;}
  .desc ul.plain > li{margin-bottom:4px;}
  .desc p{margin:0 0 10px;}
  .desc p:last-child{margin-bottom:0;}
  .desc .sub-label{
    display:inline-block;
    font-weight:700;
    font-size:12.5px;
    background:var(--teal-light);
    color:#06393b;
    padding:1px 8px;
    border-radius:4px;
    margin:10px 0 6px;
  }

  /* ---------- generic tables ---------- */
  .table-wrap{overflow-x:auto;margin-bottom:16px;}
  table{
    width:100%;
    border-collapse:collapse;
    font-size:13.5px;
  }
  table caption{text-align:left;font-weight:700;margin-bottom:6px;}
  th,td{
    border:1px solid var(--border);
    padding:8px 10px;
    text-align:left;
    vertical-align:top;
  }
  thead th{
    background:var(--navy);
    color:#fff;
    font-weight:600;
    white-space:nowrap;
  }
  tbody tr:nth-child(even){background:#f7f8fb;}
  table.compact td, table.compact th{padding:6px 8px;font-size:12.8px;}
  td ol.compact-list{margin:8px 0 0;padding-left:1.2em;font-size:12.5px;}
  td ol.compact-list > li{margin-bottom:3px;}

  /* revision history */
  table.revision td:first-child, table.revision th:first-child{text-align:center;white-space:nowrap;}
  table.revision td:nth-child(2){white-space:nowrap;}

  /* parts catalog */
  .parts-group{margin-bottom:30px;}
  .parts-group:last-child{margin-bottom:0;}
  .parts-group-title{
    background:var(--teal);
    color:#fff;
    padding:8px 16px;
    border-radius:6px 6px 0 0;
    font-weight:700;
    font-size:14px;
  }
  .part-card{
    border:1px solid var(--border);
    border-top:none;
    padding:16px;
  }
  .parts-group .part-card:last-child{border-radius:0 0 8px 8px;}
  .part-card .part-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:10px;
  }
  .part-card .part-icon{
    font-size:11px;
    font-weight:700;
    background:var(--navy);
    color:#fff;
    padding:3px 9px;
    border-radius:4px;
  }
  .part-card .part-name{font-weight:700;font-size:14.5px;}
  .part-card .part-sub{color:var(--text-soft);font-size:12.5px;}
  .part-card .includes{
    margin-top:10px;
    font-size:12.8px;
    background:#f4f6fb;
    border-radius:6px;
    padding:8px 12px;
  }
  .part-card .includes b{display:block;margin-bottom:3px;}

  /* TOC page anchor targets get a little top margin for sticky offset */
  .anchor-target{scroll-margin-top:14px;}

  footer.page-footer{
    max-width:var(--maxw);
    margin:0 auto;
    padding:0 20px 60px;
    color:var(--text-soft);
    font-size:12.5px;
  }

  .maint-note{
    background:#fff7e8;
    border:1px solid #f0d59a;
    color:#6b4c00;
    border-radius:8px;
    padding:12px 16px;
    font-size:13px;
    margin-bottom:20px;
  }
</style>
</head>

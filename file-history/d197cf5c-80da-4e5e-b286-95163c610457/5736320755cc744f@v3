<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  componentDidMount() {
    this.p = 0;
    this.measure = this.measure.bind(this);
    this.onScroll = this.onScroll.bind(this);
    window.addEventListener('scroll', this.onScroll, { passive: true });
    window.addEventListener('resize', this.measure);
    const layer = document.querySelector('.pn-notes');
    if (layer && window.ResizeObserver) {
      this.ro = new ResizeObserver(this.measure);
      this.ro.observe(layer);
    }
    this.measure();
    requestAnimationFrame(this.measure);
    setTimeout(this.measure, 600);
    this.onScroll();
  }
  componentWillUnmount() {
    window.removeEventListener('scroll', this.onScroll);
    window.removeEventListener('resize', this.measure);
    if (this.ro) this.ro.disconnect();
  }
  // 左上 → 中央右端 → 左下 を通る大きな波線
  measure() {
    const layer = document.querySelector('.pn-notes');
    if (!layer) return;
    const r = layer.getBoundingClientRect();
    const w = r.width, h = r.height;
    if (!w || !h) return;
    if (w === this._w && h === this._h) return;
    this._w = w; this._h = h;
    const d = [
      'M', 0.10 * w, 0.10 * h,
      'C', 0.58 * w, 0.09 * h, 0.96 * w, 0.20 * h, 0.88 * w, 0.50 * h,
      'C', 0.81 * w, 0.77 * h, 0.44 * w, 0.79 * h, 0.11 * w, 0.93 * h
    ].map(v => (typeof v === 'number' ? v.toFixed(1) : v)).join(' ');
    const svg = layer.querySelector('.pn-wave');
    svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
    this.ghost = layer.querySelector('.pn-wave__ghost');
    this.live = layer.querySelector('.pn-wave__live');
    this.ghost.setAttribute('d', d);
    this.live.setAttribute('d', d);
    this.len = this.live.getTotalLength();
    this.live.style.strokeDasharray = this.len;
    this.notes = [
      { el: layer.querySelector('.pn-note--lead'), lag: 0 },
      { el: layer.querySelector('.pn-note--trail-a'), lag: 0.035 },
      { el: layer.querySelector('.pn-note--trail-b'), lag: 0.075 }
    ];
    this.paint(this.p);
  }
  onScroll() {
    if (this.raf) return;
    this.raf = requestAnimationFrame(() => {
      this.raf = null;
      const doc = document.documentElement;
      const max = Math.max(1, doc.scrollHeight - window.innerHeight);
      this.p = Math.min(1, Math.max(0, window.scrollY / max));
      this.paint(this.p);
    });
  }
  paint(p) {
    if (!this.live || !this.len) return;
    this.live.style.strokeDashoffset = this.len * (1 - p);
    for (const n of this.notes) {
      if (!n.el) continue;
      const t = Math.max(0, p - n.lag);
      const a = this.live.getPointAtLength(this.len * t);
      const b = this.live.getPointAtLength(Math.min(this.len, this.len * t + 6));
      const ang = Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI;
      n.el.style.transform = 'translate(' + (a.x - 10).toFixed(1) + 'px,' + (a.y - 12).toFixed(1) + 'px) rotate(' + (ang * 0.25).toFixed(2) + 'deg)';
      n.el.style.opacity = String(Math.min(1, Math.max(0, (p - n.lag) / 0.02 + 1)));
    }
  }
}
</script>

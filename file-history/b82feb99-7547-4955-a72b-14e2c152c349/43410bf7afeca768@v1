<script type="text/x-dc" data-dc-script data-props="{&quot;motionStrength&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1,&quot;min&quot;:0,&quot;max&quot;:2,&quot;step&quot;:0.1,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;アニメーション&quot;},&quot;iconParallax&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;アニメーション&quot;}}">
class Component extends DCLogic {
  state = { menu: false, other: false, sent: false };

  componentDidMount() {
    this._onKey = (e) => { if (e.key === "Escape" && this.state.menu) this.setState({ menu: false }); };
    document.addEventListener("keydown", this._onKey);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const strength = this.props.motionStrength ?? 1;
    const rider = () => document.getElementById("flow-rider");
    const fill = () => document.getElementById("flow-fill");

    const reveal = (el) => { el.style.opacity = "1"; el.style.transform = "none"; };
    const prep = () => document.querySelectorAll("[data-reveal]:not([data-prepped])").forEach((el, i) => {
      el.setAttribute("data-prepped", "1");
      if (reduce) return;
      el.style.opacity = "0";
      el.style.transform = "translateY(26px)";
      el.style.transition = "opacity .9s cubic-bezier(.2,.7,.2,1) " + ((i % 4) * 70) + "ms, transform .9s cubic-bezier(.2,.7,.2,1) " + ((i % 4) * 70) + "ms";
    });

    const update = () => {
      const vh = window.innerHeight || 800;
      const doc = document.documentElement;
      // スクロールしている要素を毎フレーム実測して進行度を求める（末端で必ず100%になる）
      const se = document.scrollingElement || doc;
      let top = window.scrollY || se.scrollTop || 0;
      let max = se.scrollHeight - se.clientHeight;
      if (max < 4) {
        const host = document.body;
        top = host.scrollTop || top;
        max = host.scrollHeight - host.clientHeight;
      }
      const p = Math.min(1, Math.max(0, top / Math.max(1, max)));

      const f = fill(); if (f) f.style.width = (p * 100).toFixed(2) + "%";
      const r = rider();
      if (r) {
        const track = r.parentElement ? r.parentElement.clientWidth : 375;
        const half = r.offsetWidth / 2 || 15;
        r.style.left = Math.min(track - half, Math.max(half, p * track)).toFixed(1) + "px";
        if (!reduce) r.style.transform = "translate(-50%,0) rotate(" + (p * 300).toFixed(1) + "deg)";
      }

      if (!reduce && this.props.iconParallax !== false) {
        document.querySelectorAll("[data-float]").forEach((el) => {
          const box = el.getBoundingClientRect();
          const t = Math.min(1.15, Math.max(-0.15, 1 - (box.top + box.height / 2) / vh));
          const amt = parseFloat(el.getAttribute("data-float")) * strength;
          el.style.transform = "translateY(" + ((0.5 - t) * amt).toFixed(2) + "px) rotate(" + ((t - 0.5) * amt * 0.35).toFixed(2) + "deg)";
        });
      }

      // 受け渡しの曲線はJSで生成する（エディタ往復でSVGが失われないように）
      document.querySelectorAll("[data-connector]").forEach((slot) => {
        if (slot.firstElementChild) return;
        const dir = slot.getAttribute("data-connector");
        const d = dir === "rl" ? "M282,0 C282,36 18,18 18,54" : "M18,0 C18,36 282,18 282,54";
        slot.innerHTML =
          '<svg viewBox="0 0 300 54" preserveAspectRatio="none" style="display:block;width:100%;height:54px;overflow:visible">' +
          '<path data-draw d="' + d + '" fill="none" stroke="#FFC72C" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg>';
      });

      // 画像は値が解決してから src を付ける（{{ }} のままリクエストしない）
      document.querySelectorAll("img[data-src]").forEach((img) => {
        const v = img.getAttribute("data-src");
        if (v && v.indexOf("{{") === -1 && img.getAttribute("src") !== v) img.setAttribute("src", v);
      });

      // つながりの曲線：スクロールに合わせて線が描かれる
      document.querySelectorAll("[data-draw]").forEach((path) => {
        if (!path.dataset.len) {
          const len = path.getTotalLength();
          path.dataset.len = String(len);
          path.style.strokeDasharray = len;
          path.style.strokeDashoffset = len;
        }
        const len = parseFloat(path.dataset.len);
        const box = path.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, (vh * 0.82 - box.top) / (box.height + 70)));
        path.style.strokeDashoffset = (len * (1 - t)).toFixed(1);
      });

      document.querySelectorAll("[data-reveal]").forEach((el) => {
        if (el.style.opacity === "1") return;
        if (el.getBoundingClientRect().top < vh * 0.92) reveal(el);
      });
    };
    // ループはコンポーネントの外側（window）で1本だけ動かす。
    // 再マウント/ホットリロードで unmount されてもスクロール演出が止まらないようにする。
    const safe = () => { try { prep(); update(); } catch (e) { /* 1フレームの失敗で演出全体を止めない */ } };
    window.__flowTick = safe;
    // マウントごとにループを張り直す（古いチェーンは必ず破棄する）
    if (window.__flowRaf) cancelAnimationFrame(window.__flowRaf);
    const loop = () => { if (window.__flowTick) window.__flowTick(); window.__flowRaf = requestAnimationFrame(loop); };
    window.__flowRaf = requestAnimationFrame(loop);
    // rAFが止まっても最低限スクロールで追随できる保険
    if (window.__flowScroll) {
      window.removeEventListener("scroll", window.__flowScroll);
      window.removeEventListener("resize", window.__flowScroll);
      clearInterval(window.__flowInterval);
    }
    window.__flowScroll = () => { if (window.__flowTick) window.__flowTick(); };
    window.addEventListener("scroll", window.__flowScroll, { passive: true });
    window.addEventListener("resize", window.__flowScroll);
    window.__flowInterval = setInterval(window.__flowScroll, 250);
    safe();
  }

  componentWillUnmount() {
    document.removeEventListener("keydown", this._onKey);
  }

  renderVals() {
    const S = (typeof window !== "undefined" && window.SITE) || {};
    const social = S.social || {}, pages = S.pages || {}, contact = S.contact || {};
    const g = contact.gform || {};
    const open = this.state.menu;
    const bar = "display:block;width:26px;height:2px;border-radius:2px;background:" + (open ? "#F4FBFE" : "#0E4257") + ";transition:transform .4s cubic-bezier(.2,.7,.2,1),width .4s ease,background .3s ease";
    return {
      menuOpen: open,
      toggleMenu: () => this.setState((s) => ({ menu: !s.menu })),
      closeMenu: () => this.setState({ menu: false }),
      markStyle:
        "pointer-events:auto;font-family:Jost,sans-serif;font-size:13px;letter-spacing:0.16em;color:#0E4257;transition:opacity .3s ease;" +
        (open ? "opacity:0;pointer-events:none" : "opacity:1"),
      barTop: bar + (open ? ";transform:translateY(5px) rotate(14deg)" : ""),
      barBottom: bar + (open ? ";width:26px;transform:translateY(-5px) rotate(-14deg)" : ";width:18px"),
      overlayStyle:
        "position:fixed;top:0;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,375px);z-index:80;background:linear-gradient(170deg,#0E4257,#0A3243 60%,#0E4257);display:flex;flex-direction:column;justify-content:flex-start;align-items:stretch;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:92px clamp(20px,6cqw,80px) 40px;" +
        "transition:opacity .5s ease,visibility .5s ease,clip-path .7s cubic-bezier(.2,.7,.2,1);" +
        (open
          ? "opacity:1;visibility:visible;clip-path:inset(0 0 0% 0);pointer-events:auto"
          : "opacity:0;visibility:hidden;clip-path:inset(0 0 100% 0);pointer-events:none"),
      works: (S.works || []).map((w) => Object.assign({}, w, { thumbUrl: "icons/" + w.thumb })),
      instagram: social.instagram || "#",
      x: social.x || "#",
      note: social.note || "#",
      pianistUrl: pages.pianist || "Pianist.dc.html",
      horrorUrl: pages.horror || "Horror.dc.html",
      gAction: g.action || "",
      fName: g.name || "",
      fKana: g.kana || "",
      fEmail: g.email || "",
      fGenre: g.genre || "",
      fGenreOther: g.genreOther || "",
      fMessage: g.message || "",
      fPrivacy: g.privacy || "",
      privacyUrl: g.privacyUrl || "#",
      pickGenre: () => { if (this.state.other) this.setState({ other: false }); },
      pickOther: () => this.setState({ other: true }),
      otherStyle:
        "width:100%;font:inherit;font-size:16px;color:#0E4257;background:transparent;border:none;border-bottom:1px solid rgba(79,195,232,0.5);padding:8px 0;outline:none;margin-left:30px;max-width:calc(100% - 30px);" +
        (this.state.other ? "display:block" : "display:none"),
      onSubmit: () => { setTimeout(() => this.setState({ sent: true }), 400); },
      formStyle: "margin-top:clamp(36px,6cqw,72px);border-top:1px solid rgba(79,195,232,0.32);padding-top:clamp(30px,4cqw,48px);" + (this.state.sent ? "display:none" : "display:block"),
      thanksStyle: "margin-top:clamp(36px,6cqw,72px);border-top:1px solid rgba(79,195,232,0.32);padding-top:clamp(30px,4cqw,48px);" + (this.state.sent ? "display:block" : "display:none")
    };
  }
}

</script>

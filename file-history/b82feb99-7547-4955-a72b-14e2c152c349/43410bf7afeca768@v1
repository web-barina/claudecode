              <label style="display:flex;align-items:center;gap:12px;font-size:15px;color:#2E7793;cursor:pointer">
                <input type="radio" name="{{ fGenre }}" value="ピアノ演奏について" onChange="{{ pickGenre }}" style="accent-color:#FFC72C;width:18px;height:18px">
                ピアノ演奏について
              </label>
              <label style="display:flex;align-items:center;gap:12px;font-size:15px;color:#2E7793;cursor:pointer">
                <input type="radio" name="{{ fGenre }}" value="__other_option__" onChange="{{ pickOther }}" style="accent-color:#FFC72C;width:18px;height:18px">
                その他
              </label>
              <input type="text" name="{{ fGenreOther }}" aria-label="その他の内容" placeholder="その他の内容" style="{{ otherStyle }}">
            </fieldset>
            <label style="display:grid;gap:8px">
              <span style="font-size:13px;font-weight:500;color:#2E7793">お問い合わせ詳細 <span style="color:#B57E00">*</span></span>
              <span style="font-size:12px;color:#4E9DBC;line-height:1.8">詳細に書いていただけますと、こちらも回答しやすいです。</span>
              <textarea name="{{ fMessage }}" required="required" rows="5" style="width:100%;font:inherit;font-size:16px;color:#0E4257;background:#FFFFFF;border:1px solid rgba(79,195,232,0.4);border-radius:14px;padding:14px;outline:none;resize:vertical" style-focus="border-color:#B57E00"></textarea>
            </label>
            <label style="display:flex;align-items:flex-start;gap:12px;font-size:14px;color:#2E7793;line-height:1.9;cursor:pointer">
              <input type="checkbox" name="{{ fPrivacy }}" value="同意します" required="required" style="accent-color:#FFC72C;width:18px;height:18px;margin-top:3px">
              <span><a href="{{ privacyUrl }}" target="_blank" rel="noopener" style="border-bottom:1px solid rgba(79,195,232,0.6)">プライバシーポリシー</a>に同意します</span>
            </label>
            <button type="submit" style="margin-top:8px;justify-self:center;display:inline-flex;align-items:center;gap:16px;background:linear-gradient(120deg,#FFC72C,#FFE07A);color:#0E4257;font-weight:700;font-family:Jost,sans-serif;font-size:14px;letter-spacing:0.16em;padding:20px 40px;border:none;border-radius:999px;cursor:pointer;box-shadow:0 14px 28px rgba(255,199,44,0.26);transition:gap .3s ease,box-shadow .3s ease" style-hover="gap:26px;box-shadow:0 18px 34px rgba(255,199,44,0.34)">送信する →</button>
          </div>
        </form>

        <div style="{{ thanksStyle }}" role="status">
          <p style="margin:0;font-family:Jost,sans-serif;font-size:11px;letter-spacing:0.24em;color:#B57E00">送信完了</p>
          <p style="margin:18px 0 0;font-size:17px;font-weight:500;color:#0E4257">お問い合わせありがとうございます。</p>
          <p style="margin:14px 0 0;font-size:14px;line-height:2;color:#2E7793">1週間を目処にご返信いたします。<br>内容によってはお時間をいただく場合があります。</p>
        </div>
      </div>
    </section>
  </main>

  <div aria-hidden="true" style="line-height:0;background:linear-gradient(180deg,#2A97C4,#0E4257);position:relative">
    <svg viewBox="0 0 375 72" preserveAspectRatio="none" style="display:block;width:100%;height:clamp(44px,7cqw,84px)">
      <path d="M0,40 C66,66 132,10 200,30 C262,48 318,64 375,38 L375,0 L0,0 Z" fill="#F1FAFD"></path>
    </svg>
  </div>

  <footer style="background:linear-gradient(180deg,#0E4257,#0A3243);color:#F4FBFE;padding:clamp(44px,6cqw,90px) clamp(20px,6cqw,80px) clamp(26px,3cqw,40px);margin-top:auto">
    <div style="max-width:1280px;margin:0 auto;display:grid;gap:clamp(26px,4cqw,60px);align-items:start">
      <div>
        <p style="margin:0;font-family:Jost,sans-serif;font-size:clamp(26px,3.4cqw,44px);letter-spacing:0.02em">RINA OBA</p>
        <p style="margin:10px 0 0;font-size:13px;color:#7FCBE4">Webディレクター / プランナー</p>
      </div>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:22px;font-family:Jost,sans-serif;font-size:13px;letter-spacing:0.1em">
        <li><a href="{{ instagram }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;color:#A6DDEF"><img src="icons/icon-instagram.svg" alt="" aria-hidden="true" style="width:18px;height:18px;filter:brightness(0) invert(1);opacity:.85">Instagram</a></li>
        <li><a href="{{ x }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;color:#A6DDEF"><img src="icons/icon-x.svg" alt="" aria-hidden="true" style="width:18px;height:18px;filter:brightness(0) invert(1);opacity:.85">X</a></li>
        <li><a href="{{ note }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;color:#A6DDEF"><img src="icons/icon-note.svg" alt="" aria-hidden="true" style="width:18px;height:18px;filter:brightness(0) invert(1);opacity:.85">note</a></li>
      </ul>
    </div>
    <p style="max-width:1280px;margin:clamp(32px,5cqw,72px) auto 0;font-family:Jost,sans-serif;font-size:11px;letter-spacing:0.16em;color:#4E9DBC">© RINA OBA</p>
  </footer>


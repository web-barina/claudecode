<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { menu: false, other: false, sent: false };

  componentDidMount() {
    this._onKey = (e) => { if (e.key === "Escape" && this.state.menu) this.setState({ menu: false }); };
    document.addEventListener("keydown", this._onKey);
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.style.opacity = "1";
        en.target.style.transform = "none";
        io.unobserve(en.target);
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    this._io = io;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const scan = () => document.querySelectorAll("[data-reveal]:not([data-revealed])").forEach((el, i) => {
      el.setAttribute("data-revealed", "1");
      if (reduce) return;
      el.style.opacity = "0";
      el.style.transform = "translateY(20px)";
      el.style.transition = "opacity .9s cubic-bezier(.2,.7,.2,1) " + ((i % 4) * 60) + "ms, transform .9s cubic-bezier(.2,.7,.2,1) " + ((i % 4) * 60) + "ms";
      io.observe(el);
    });
    const revealAll = () => document.querySelectorAll("[data-reveal]").forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
    scan();
    this._scan = setInterval(scan, 400);
    const de = document.documentElement;
    // rect polling: works even when the host never emits scroll events
    this._poll = setInterval(() => {
      document.querySelectorAll("[data-reveal]").forEach((el) => {
        if (el.style.opacity === "1") return;
        if (el.getBoundingClientRect().top < window.innerHeight * 1.15) {
          el.style.opacity = "1";
          el.style.transform = "none";
        }
      });
    }, 250);
    // hard fail-safe: content is never allowed to stay hidden
    this._fallback = setTimeout(revealAll, 4000);
    void de;
    setTimeout(() => clearInterval(this._scan), 6000);
  }

  componentWillUnmount() {
    document.removeEventListener("keydown", this._onKey);
    if (this._io) this._io.disconnect();
    clearInterval(this._poll);
    clearTimeout(this._fallback);
    clearInterval(this._scan);
  }

  renderVals() {
    const S = (typeof window !== "undefined" && window.SITE) || {};
    const social = S.social || {}, pages = S.pages || {}, contact = S.contact || {};
    const g = contact.gform || {};
    const open = this.state.menu;
    const bar = "display:block;width:26px;height:1px;background:#F5F8FC;transition:transform .4s cubic-bezier(.2,.7,.2,1),width .4s ease";
    return {
      menuOpen: open,
      toggleMenu: () => this.setState((s) => ({ menu: !s.menu })),
      closeMenu: () => this.setState({ menu: false }),
      markStyle:
        "pointer-events:auto;font-family:Archivo,sans-serif;font-size:13px;letter-spacing:0.16em;color:#F5F8FC;transition:opacity .3s ease;" +
        (open ? "opacity:0;pointer-events:none" : "opacity:1"),
      barTop: bar + (open ? ";transform:translateY(4px) rotate(15deg)" : ""),
      barBottom: bar + (open ? ";width:26px;transform:translateY(-4px) rotate(-15deg)" : ";width:18px"),
      overlayStyle:
        "position:fixed;top:0;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,430px);z-index:80;background:#0E1B30;display:flex;flex-direction:column;justify-content:flex-start;align-items:stretch;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:88px clamp(20px,6cqw,80px) 40px;" +
        "transition:opacity .5s ease,visibility .5s ease,clip-path .7s cubic-bezier(.2,.7,.2,1);" +
        (open
          ? "opacity:1;visibility:visible;clip-path:inset(0 0 0% 0);pointer-events:auto"
          : "opacity:0;visibility:hidden;clip-path:inset(0 0 100% 0);pointer-events:none"),
      works: S.works || [],
      instagram: social.instagram || "#",
      x: social.x || "#",
      note: social.note || "#",
      pianistUrl: pages.pianist || "Pianist.dc.html",
      horrorUrl: pages.horror || "Horror.dc.html",
      formUrl: contact.formUrl || "#",
      gAction: g.action || "",
      fName: g.name || "",
      fKana: g.kana || "",
      fEmail: g.email || "",
      fGenre: g.genre || "",
      fGenreOther: g.genreOther || "",
      fMessage: g.message || "",
      fPrivacy: g.privacy || "",
      privacyUrl: g.privacyUrl || "#",
      pickGenre: () => { if (this.state.other) this.setState({ other: false }); },
      pickOther: () => this.setState({ other: true }),
      otherStyle:
        "width:100%;font:inherit;font-size:16px;color:#12243F;background:transparent;border:none;border-bottom:1px solid #C2D2E4;padding:8px 0;outline:none;margin-left:30px;max-width:calc(100% - 30px);transition:border-color .3s ease;" +
        (this.state.other ? "display:block" : "display:none"),
      onSubmit: () => { setTimeout(() => this.setState({ sent: true }), 400); },
      formStyle: "margin-top:clamp(40px,6cqw,72px);border-top:1px solid #D3DEEB;padding-top:clamp(32px,4cqw,48px);" + (this.state.sent ? "display:none" : "display:block"),
      thanksStyle: "margin-top:clamp(40px,6cqw,72px);border-top:1px solid #D3DEEB;padding-top:clamp(32px,4cqw,48px);" + (this.state.sent ? "display:block" : "display:none")
    };
  }
}

</script>

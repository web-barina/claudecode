      menuClass: "menu" + (open ? " is-open" : ""),
      formFieldsetClass: "form__fieldset" + (other ? " is-other" : ""),
      pickGenre: () => { if (this.state.other) this.setState({ other: false }); },
      pickOther: () => this.setState({ other: true }),
      onSubmit: () => { trackEvent("generate_lead"); setTimeout(() => this.setState({ sent: true }), 400); },
      formClass: "form" + (sent ? " is-sent" : ""),
      thanksClass: "thanks" + (sent ? " is-sent" : ""),
      modalClass: "modal-overlay" + (this.state.modal != null ? " is-open" : ""),
      backToTopClass: this.state.showTop ? "is-visible" : "",
      modalNo: cur.no,
      modalTitle: cur.title,
      modalRoles: cur.roles,
      modalPoint: cur.point,
      modalResult: cur.result,
      openCase1: () => this.openModal(0),
      openCase2: () => this.openModal(1),
      openCase3: () => this.openModal(2),
      keyCase1: (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); this.openModal(0); } },
      keyCase2: (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); this.openModal(1); } },
      keyCase3: (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); this.openModal(2); } },
      closeModal: () => this.closeModal(),
      stop: (e) => e.stopPropagation()
    };
  }
}

</script>
</body>
</html>

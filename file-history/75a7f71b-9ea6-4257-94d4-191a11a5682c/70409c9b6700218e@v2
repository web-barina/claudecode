/* ==========================================================================
   Design tokens
   ========================================================================== */
:root {
  --color-bg: #fbfaf8;
  --color-bg-flat: #ffffff;
  --color-surface: #f3f1ec;
  --color-ink: #141311;
  --color-ink-soft: #4a4843;
  --color-ink-faint: #67635a;
  --color-line: #ddd9d0;
  --color-line-strong: #141311;
  --color-accent: #ad3f1d;
  --color-accent-soft: #f2e2da;
  --color-inverse: #fbfaf8;

  --font-serif: "Zen Old Mincho", "Noto Serif JP", serif;
  --font-sans: "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", sans-serif;
  --font-label: "Archivo", "Zen Kaku Gothic New", sans-serif;

  --container-w: min(1240px, 92vw);
  --container-w-narrow: min(880px, 92vw);

  --section-pad-y: clamp(5rem, 11vw, 9rem);
  --radius-sm: 2px;

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 0.28s;
  --dur-med: 0.6s;
  --dur-slow: 0.9s;
}

/* ==========================================================================
   Reset
   ========================================================================== */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.85;
  font-feature-settings: "palt" 1;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

body.is-menu-open {
  overflow: hidden;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

h1,
h2,
h3,
h4,
p {
  margin: 0;
}

button {
  font: inherit;
  color: inherit;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
}

input,
textarea {
  font: inherit;
  color: inherit;
}

/* ==========================================================================
   Focus visibility (keyboard support)
   ========================================================================== */
a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
  border-radius: var(--radius-sm);
}

.skip-link {
  position: absolute;
  top: -100%;
  left: 1rem;
  z-index: 200;
  background: var(--color-ink);
  color: var(--color-inverse);
  padding: 0.75em 1.25em;
  font-size: 0.875rem;
  transition: top var(--dur-fast) var(--ease-out);
}

.skip-link:focus {
  top: 1rem;
}

/* ==========================================================================
   Layout helpers
   ========================================================================== */
.container {
  width: var(--container-w);
  margin-inline: auto;
}

.container-narrow {
  width: var(--container-w-narrow);
  margin-inline: auto;
}

.section {
  position: relative;
  padding-block: var(--section-pad-y);
}

.section-inner {
  width: var(--container-w);
  margin-inline: auto;
}

/* ==========================================================================
   Typography system
   ========================================================================== */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.65em;
  font-family: var(--font-label);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-ink-faint);
}

.eyebrow::before {
  content: "";
  display: inline-block;
  width: 1.75em;
  height: 1px;
  background: var(--color-accent);
}

.section-heading {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: clamp(2.2rem, 5.4vw, 3.6rem);
  line-height: 1.15;
  letter-spacing: 0.01em;
  margin-top: 0.5em;
}

.section-copy {
  font-family: var(--font-serif);
  font-size: clamp(1.25rem, 2.4vw, 1.7rem);
  line-height: 1.6;
  font-weight: 600;
  margin-top: 1.4em;
  color: var(--color-ink);
}

.section-lede {
  max-width: 46ch;
  color: var(--color-ink-soft);
  font-size: 1rem;
  line-height: 2;
  margin-top: 1.8em;
}

.num-index {
  font-family: var(--font-label);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: var(--color-accent);
}

/* ==========================================================================
   Buttons / links
   ========================================================================== */
.link-underline {
  position: relative;
  display: inline-block;
}

.link-underline::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -0.15em;
  width: 100%;
  height: 1px;
  background: currentColor;
  transform: scaleX(1);
  transform-origin: left;
  transition: transform var(--dur-fast) var(--ease-out);
}

.link-underline:hover::after,
.link-underline:focus-visible::after {
  transform: scaleX(0);
  transform-origin: right;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.75em;
  font-family: var(--font-label);
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 1.1em 1.9em;
  border: 1px solid var(--color-line-strong);
  border-radius: 999px;
  color: var(--color-ink);
  transition: background var(--dur-fast) var(--ease-out),
    color var(--dur-fast) var(--ease-out),
    transform var(--dur-fast) var(--ease-out);
}

.btn:hover,
.btn:focus-visible {
  background: var(--color-ink);
  color: var(--color-inverse);
  transform: translateY(-2px);
}

.btn-arrow {
  transition: transform var(--dur-fast) var(--ease-out);
}

.btn:hover .btn-arrow,
.btn:focus-visible .btn-arrow {
  transform: translateX(4px);
}

/* ==========================================================================
   Scroll reveal
   ========================================================================== */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity var(--dur-slow) var(--ease-out),
    transform var(--dur-slow) var(--ease-out);
  transition-delay: var(--reveal-delay, 0s);
  will-change: opacity, transform;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ==========================================================================
   Misc
   ========================================================================== */
#about,
#what-i-do,
#strength,
#works,
#process,
#career,
#now-next,
#contact {
  scroll-margin-top: 5.5rem;
}

.hr-line {
  border: none;
  border-top: 1px solid var(--color-line);
  margin: 0;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

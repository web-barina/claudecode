---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/config";
import { horrorWorks } from "../../data/horror";
---

<BaseLayout
  title={`HORROR | ${siteConfig.name}`}
  description="趣味で制作しているホラーアニメーションや作品を掲載するページ。"
  theme="dark"
  bodyClass="page-horror"
>
  <div class="horror">
    <section class="horror__gate" aria-labelledby="gate-title">
      <p class="horror__gate-kicker">WARNING</p>
      <h1 id="gate-title" class="horror__gate-title">
        THIS PAGE CONTAINS<br />
        SOMETHING I MADE<br />
        JUST FOR FUN.
      </h1>
      <a href="#horror-content" class="horror__enter" data-horror-enter>
        <span>ENTER?</span>
      </a>
    </section>

    <section id="horror-content" class="horror__content" data-horror-content aria-label="HORROR作品一覧">
      <div class="section-inner">
        <p class="horror__eyebrow reveal">Personal / 02</p>
        <h2 class="horror__title reveal" style="--reveal-delay:0.08s" tabindex="-1">HORROR</h2>
        <p class="horror__lede reveal" style="--reveal-delay:0.16s">
          趣味で制作しているホラーアニメーションや作品を掲載できるページ。
        </p>

        <ul class="horror__list">
          {
            horrorWorks.map((work, i) => (
              <li class="horror__item reveal" style={`--reveal-delay:${0.08 * i}s`}>
                <span class="horror__item-num">{work.number}</span>
                <span class="horror__item-title">{work.title}</span>
                <span class="horror__item-year">{work.year}</span>
                <p class="horror__item-note">{work.note}</p>
              </li>
            ))
          }
        </ul>

        <a href="/" class="horror__back link-underline">← BACK TO TOP</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initHorrorGate() {
    const enterLink = document.querySelector<HTMLAnchorElement>("[data-horror-enter]");
    const content = document.querySelector<HTMLElement>("[data-horror-content]");
    const root = document.querySelector<HTMLElement>(".horror");
    if (!enterLink || !content || !root || root.dataset.gateBound) return;
    root.dataset.gateBound = "true";

    content.inert = true;

    enterLink.addEventListener("click", (e) => {
      e.preventDefault();
      root.classList.add("is-entered");
      content.inert = false;
      const gate = root.querySelector<HTMLElement>(".horror__gate");
      const heading = content.querySelector<HTMLElement>(".horror__title");
      content.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => {
        if (gate) gate.inert = true;
        heading?.focus();
      }, 350);
    });
  }

  document.addEventListener("astro:page-load", initHorrorGate);
</script>

<style>
  .horror {
    background: #07070a;
    color: #eeece7;
    min-height: 100svh;
  }

  .horror__gate {
    position: relative;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    overflow: hidden;
    transition: opacity var(--dur-slow) var(--ease-in-out),
      height var(--dur-slow) var(--ease-in-out) var(--dur-fast);
    background:
      radial-gradient(ellipse at 50% 30%, rgba(255, 255, 255, 0.05), transparent 60%),
      #07070a;
  }

  .horror.is-entered .horror__gate {
    opacity: 0;
    height: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .horror__gate {
      transition: none;
    }
  }

  .horror__gate-kicker {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    color: #8a8580;
    animation: flicker 3.6s ease-in-out infinite;
  }

  @keyframes flicker {
    0%,
    92%,
    100% {
      opacity: 1;
    }
    94% {
      opacity: 0.35;
    }
    96% {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .horror__gate-kicker {
      animation: none;
    }
  }

  .horror__gate-title {
    margin-top: 1.75rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 4.4vw, 2.4rem);
    line-height: 1.5;
    color: #eeece7;
    max-width: 20ch;
  }

  .horror__enter {
    margin-top: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    border: 1px solid #4a463f;
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #eeece7;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .horror__enter:hover,
  .horror__enter:focus-visible {
    background: #eeece7;
    color: #07070a;
    transform: scale(1.05);
  }

  .horror__content {
    padding-block: clamp(5rem, 12vw, 8rem);
    scroll-margin-top: 0;
  }

  .horror__eyebrow {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: #8a8580;
  }

  .horror__title {
    margin-top: 0.5em;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.6rem, 7vw, 5rem);
    color: #eeece7;
  }

  .horror__lede {
    margin-top: 1.4em;
    max-width: 46ch;
    color: #b1ada5;
    line-height: 1.9;
  }

  .horror__list {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid #262420;
  }

  .horror__item {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    border-bottom: 1px solid #262420;
  }

  .horror__item-num {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #706c65;
  }

  .horror__item-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    color: #eeece7;
  }

  .horror__item-year {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #8a8580;
  }

  .horror__item-note {
    grid-column: 1 / -1;
    color: #8a8580;
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  .horror__back {
    display: inline-block;
    margin-top: 3rem;
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: #eeece7;
  }

  @media (max-width: 600px) {
    .horror__item {
      grid-template-columns: 3.5rem 1fr;
    }
    .horror__item-year {
      grid-column: 2 / 3;
    }
  }
</style>

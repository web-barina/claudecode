---
import { siteConfig } from "../data/config";
---

<header class="site-header">
  <a href="#top" class="site-header__logo link-underline">{siteConfig.name}</a>
  <button
    type="button"
    class="menu-toggle"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span class="menu-toggle__label">MENU</span>
    <span class="menu-toggle__icon" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
  </button>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(1.1rem, 2.4vw, 1.6rem) clamp(1.25rem, 4vw, 2.75rem);
    pointer-events: none;
  }

  .site-header__logo {
    pointer-events: auto;
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 0.5em 0.7em;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(6px);
    border-radius: 999px;
  }

  .menu-toggle {
    pointer-events: auto;
    position: relative;
    z-index: 210;
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.55em 0.5em 0.55em 1.1em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(6px);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .menu-toggle[aria-expanded="true"] {
    background: transparent;
  }

  .menu-toggle__label {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__label {
    color: var(--color-inverse);
  }

  .menu-toggle__icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    padding: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon {
    border-color: var(--color-inverse);
  }

  .menu-toggle__icon span {
    display: block;
    width: 13px;
    height: 1px;
    margin-inline: auto;
    background: var(--color-ink);
    transition: transform var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon span {
    background: var(--color-inverse);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
</style>

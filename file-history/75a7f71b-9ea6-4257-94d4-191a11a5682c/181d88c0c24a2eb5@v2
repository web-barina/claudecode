import { chromium } from "playwright";
import fs from "node:fs";

const outDir = "/private/tmp/claude-501/-Users-rina--claude/75a7f71b-9ea6-4257-94d4-191a11a5682c/scratchpad/shots";
fs.mkdirSync(outDir, { recursive: true });

const browser = await chromium.launch();
const consoleErrors = [];

async function shot(url, name, viewport) {
  const page = await browser.newPage({ viewport });
  page.on("console", (msg) => {
    if (msg.type() === "error") consoleErrors.push(`[${name}] ${msg.text()}`);
  });
  page.on("pageerror", (err) => consoleErrors.push(`[${name}] pageerror: ${err.message}`));
  await page.goto(url, { waitUntil: "networkidle" });
  await page.waitForTimeout(600);
  await page.screenshot({ path: `${outDir}/${name}.png`, fullPage: true });
  return page;
}


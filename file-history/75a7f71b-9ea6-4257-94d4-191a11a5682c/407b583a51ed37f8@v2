---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  theme?: "light" | "dark";
  bodyClass?: string;
}

const {
  title,
  description = "整理して、つないで、ちゃんと前に進める。Webディレクター RINA OBA のポートフォリオサイト。",
  theme = "light",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "dark" ? "#141311" : "#fbfaf8"} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Zen+Old+Mincho:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass} data-theme={theme}>
    <a href="#main" class="skip-link">本文へスキップ</a>

    <Header />
    <MenuOverlay />

    <div id="top"></div>
    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/reveal";
      import "../scripts/menu";
    </script>
  </body>
</html>

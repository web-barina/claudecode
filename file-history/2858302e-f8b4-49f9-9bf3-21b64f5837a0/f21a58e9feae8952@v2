results = {}
for u in urls:
    full = BASE + urllib.parse.quote(u)
    ascii_part = re.sub(r'[^a-zA-Z0-9]+', '_', u)[:40]
    h = hashlib.md5(u.encode('utf-8')).hexdigest()[:10]
    fname = f"{ascii_part}_{h}.html"
    path = os.path.join(OUT_DIR, fname)
    try:
        req = urllib.request.Request(full, headers={"User-Agent": "Mozilla/5.0 (compatible; QABot/1.0)"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            status = resp.status
            content = resp.read()
            with open(path, "wb") as f:
                f.write(content)
            results[u] = {"status": status, "file": fname, "size": len(content), "final_url": resp.geturl()}
    except urllib.error.HTTPError as e:
        results[u] = {"status": e.code, "file": None, "size": 0, "error": str(e)}
    except Exception as e:
        results[u] = {"status": None, "file": None, "size": 0, "error": str(e)}
    time.sleep(0.15)

with open(os.path.join(OUT_DIR, "_manifest.json"), "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

for u, r in results.items():
    print(r.get("status"), u, r.get("size"))

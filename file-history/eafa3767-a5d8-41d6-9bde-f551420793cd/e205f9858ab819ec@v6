<title>管理画面 操作ガイド</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700&family=IBM+Plex+Mono:wght@500;600&display=swap">

<style>
  :root{
    --paper:#FBFCFD;
    --surface:#FFFFFF;
    --panel:#EDF2F5;
    --ink:#1E2830;
    --ink-soft:#54646F;
    --line:#D7DFE5;
    --line-strong:#C2CCD3;
    --accent:#256E9B;
    --accent-ink:#1B506F;
    --accent-soft:#E2EDF4;
    --warn:#A2600C;
    --warn-soft:#F6ECDB;
    --tip:#2E7D63;
    --tip-soft:#E2F0EA;
    --todo:#8A5A00;
    --todo-soft:#FBF0D8;
    --shadow:0 1px 2px rgba(22,42,56,.05), 0 10px 30px rgba(22,42,56,.07);
    --radius:10px;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --paper:#11171C;
      --surface:#192127;
      --panel:#212B33;
      --ink:#E7ECEF;
      --ink-soft:#9EABB4;
      --line:#2F3A43;
      --line-strong:#3C4954;
      --accent:#6EB4DA;
      --accent-ink:#A9D3E8;
      --accent-soft:#1D2E39;
      --warn:#E0A85C;
      --warn-soft:#31281A;
      --tip:#79C6AC;
      --tip-soft:#1B2E28;
      --todo:#E3B778;
      --todo-soft:#322817;
      --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"]{
    --paper:#11171C;
    --surface:#192127;
    --panel:#212B33;
    --ink:#E7ECEF;
    --ink-soft:#9EABB4;
    --line:#2F3A43;
    --line-strong:#3C4954;
    --accent:#6EB4DA;
    --accent-ink:#A9D3E8;
    --accent-soft:#1D2E39;
    --warn:#E0A85C;
    --warn-soft:#31281A;
    --tip:#79C6AC;
    --tip-soft:#1B2E28;
    --todo:#E3B778;
    --todo-soft:#322817;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px rgba(0,0,0,.35);
  }

  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Noto Sans JP", system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
    font-weight:400;
    line-height:1.85;
    letter-spacing:.01em;
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    max-width:820px;
    margin:0 auto;
    padding:48px 28px 96px;
  }

  /* ---------- editor memo (screen only) ---------- */
  .memo{
    border:1px dashed var(--todo);
    background:var(--todo-soft);
    color:var(--ink);
    border-radius:var(--radius);
    padding:18px 20px;
    margin-bottom:40px;
    font-size:.86rem;
    line-height:1.7;
  }
  .memo h2{
    margin:0 0 8px;
    font:600 .7rem/1.4 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--todo);
  }
  .memo ul{margin:6px 0 0;padding-left:1.2em;}
  .memo li{margin:2px 0;}

  /* ---------- cover ---------- */
  .cover{
    border-radius:14px;
    background:
      linear-gradient(180deg, var(--accent-soft), transparent 62%),
      var(--surface);
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    padding:44px 40px 36px;
    margin-bottom:44px;
  }
  .cover__eyebrow{
    font:600 .72rem/1.4 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:var(--accent-ink);
    margin:0 0 18px;
  }
  .cover__title{
    font-family:"Zen Kaku Gothic New", "Noto Sans JP", sans-serif;
    font-weight:900;
    font-size:clamp(1.9rem, 4.6vw, 2.7rem);
    line-height:1.28;
    letter-spacing:.02em;
    text-wrap:balance;
    margin:0 0 10px;
  }
  .cover__sub{
    color:var(--ink-soft);
    font-size:.98rem;
    margin:0 0 30px;
  }
  .meta{
    width:100%;
    border-collapse:collapse;
    font-size:.9rem;
    margin-bottom:6px;
  }
  .meta th,.meta td{
    text-align:left;
    padding:9px 4px;
    border-bottom:1px solid var(--line);
    vertical-align:top;
  }
  .meta th{
    width:9.5em;
    font-weight:700;
    color:var(--ink-soft);
    font-size:.82rem;
    letter-spacing:.04em;
  }

  /* ---------- table of contents ---------- */
  .toc{
    margin-top:30px;
    border-top:2px solid var(--line-strong);
    padding-top:18px;
  }
  .toc h2{
    font:600 .72rem/1.4 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--ink-soft);
    margin:0 0 12px;
  }
  .toc ol{margin:0;padding:0;list-style:none;counter-reset:toc;}
  .toc li{
    counter-increment:toc;
    display:flex;
    align-items:baseline;
    gap:14px;
    padding:7px 0;
    border-bottom:1px dotted var(--line);
  }
  .toc li::before{
    content:counter(toc,decimal-leading-zero);
    font:600 .82rem/1 "IBM Plex Mono", ui-monospace, monospace;
    color:var(--accent);
    flex:none;
  }
  .toc a{color:var(--ink);text-decoration:none;font-weight:500;}
  .toc a:hover{color:var(--accent);text-decoration:underline;}

  /* ---------- section ---------- */
  .section{
    margin-top:56px;
    counter-increment:sec;
  }
  .section__head{
    display:flex;
    align-items:flex-start;
    gap:16px;
    padding-bottom:14px;
    border-bottom:2px solid var(--accent);
    margin-bottom:26px;
  }
  .section__num{
    font:600 .95rem/1 "IBM Plex Mono", ui-monospace, monospace;
    color:#fff;
    background:var(--accent);
    border-radius:7px;
    padding:9px 11px;
    flex:none;
    margin-top:3px;
  }
  .section__title{
    font-family:"Zen Kaku Gothic New", "Noto Sans JP", sans-serif;
    font-weight:700;
    font-size:clamp(1.35rem, 3vw, 1.7rem);
    line-height:1.35;
    letter-spacing:.02em;
    text-wrap:balance;
    margin:0;
  }
  .section__lead{
    color:var(--ink-soft);
    font-size:.95rem;
    margin:-8px 0 24px;
  }
  .subhead{
    font-family:"Zen Kaku Gothic New", "Noto Sans JP", sans-serif;
    font-weight:700;
    font-size:1.05rem;
    letter-spacing:.02em;
    margin:34px 0 14px;
    padding-left:12px;
    border-left:4px solid var(--accent);
  }

  /* ---------- steps ---------- */
  .steps{
    list-style:none;
    margin:0;
    padding:0;
    counter-reset:step;
  }
  .steps>li{
    counter-increment:step;
    position:relative;
    padding:0 0 22px 52px;
  }
  .steps>li::before{
    content:counter(step);
    position:absolute;
    left:0;
    top:0;
    width:34px;
    height:34px;
    border-radius:50%;
    background:var(--accent-soft);
    color:var(--accent-ink);
    border:1.5px solid var(--accent);
    font:600 .95rem/34px "IBM Plex Mono", ui-monospace, monospace;
    text-align:center;
  }
  .steps>li:not(:last-child)::after{
    content:"";
    position:absolute;
    left:16.5px;
    top:38px;
    bottom:2px;
    width:1.5px;
    background:var(--line-strong);
  }
  .steps>li>p{margin:5px 0 0;}
  .steps>li>p:first-child{margin-top:4px;}

  /* ---------- ui chips ---------- */
  .ui{
    display:inline-block;
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-weight:600;
    font-size:.82em;
    line-height:1.4;
    padding:1px 8px;
    border-radius:5px;
    background:var(--panel);
    border:1px solid var(--line-strong);
    white-space:nowrap;
  }
  .ui--go{
    background:var(--accent);
    color:#fff;
    border-color:var(--accent);
  }
  .path{
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-weight:600;
    font-size:.88em;
    color:var(--accent-ink);
  }

  .val{
    display:inline-block;
    padding:1px 8px;
    border-radius:5px;
    background:var(--panel);
    border:1px solid var(--line-strong);
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:.85em;
    font-weight:600;
    word-break:break-all;
    user-select:all;
  }

  /* ---------- fill-in placeholder ---------- */
  .fill{
    display:inline-block;
    min-width:9em;
    padding:0 .5em;
    background:var(--todo-soft);
    border-bottom:1.5px dashed var(--todo);
    color:var(--todo);
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-size:.85em;
    font-weight:600;
  }

  /* ---------- notes ---------- */
  .note{
    display:flex;
    gap:14px;
    align-items:flex-start;
    border-radius:var(--radius);
    padding:15px 18px;
    margin:20px 0;
    font-size:.92rem;
    line-height:1.75;
    border:1px solid var(--line);
    background:var(--panel);
  }
  .note p{margin:0;}
  .note__label{
    flex:none;
    font:600 .7rem/1.7 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing:.1em;
    text-transform:uppercase;
    padding:1px 9px;
    border-radius:5px;
  }
  .note--warn{background:var(--warn-soft);border-color:var(--warn);}
  .note--warn .note__label{background:var(--warn);color:#fff;}
  .note--tip{background:var(--tip-soft);border-color:var(--tip);}
  .note--tip .note__label{background:var(--tip);color:#fff;}

  /* ---------- screenshot frame ---------- */
  .shot{margin:22px 0;}
  .shot__box{
    aspect-ratio:16/9;
    border:2px dashed var(--line-strong);
    border-radius:var(--radius);
    background:
      repeating-linear-gradient(-45deg, transparent, transparent 12px, var(--panel) 12px, var(--panel) 24px);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--ink-soft);
    font:600 .8rem/1.5 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing:.08em;
    text-align:center;
    padding:12px;
  }
  .shot__img{
    display:block;
    width:100%;
    height:auto;
    border:1px solid var(--line-strong);
    border-radius:var(--radius);
  }
  .shot figcaption{
    margin-top:8px;
    font-size:.82rem;
    color:var(--ink-soft);
  }

  /* ---------- decoration table ---------- */
  .table-scroll{overflow-x:auto;margin:18px 0;}
  table.deco{
    width:100%;
    border-collapse:collapse;
    font-size:.9rem;
    min-width:520px;
  }
  table.deco th,table.deco td{
    text-align:left;
    padding:11px 14px;
    border:1px solid var(--line);
    vertical-align:top;
  }
  table.deco thead th{
    background:var(--accent-soft);
    color:var(--accent-ink);
    font-weight:700;
    font-size:.8rem;
    letter-spacing:.06em;
  }
  table.deco tbody tr:nth-child(even){background:var(--panel);}

  /* ---------- misc ---------- */
  a{color:var(--accent);}
  strong{font-weight:700;}
  .foot{
    margin-top:72px;
    padding-top:18px;
    border-top:1px solid var(--line);
    font-size:.8rem;
    color:var(--ink-soft);
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
  }

  :where(a,summary):focus-visible{
    outline:2px solid var(--accent);
    outline-offset:3px;
    border-radius:3px;
  }

  @media (max-width:560px){
    .wrap{padding:32px 18px 72px;}
    .cover{padding:32px 22px;}
    .section__head{gap:12px;}
    .steps>li{padding-left:44px;}
  }

  /* ---------- print / PDF ---------- */
  @media print{
    :root{
      --paper:#fff;--surface:#fff;--panel:#f0f3f5;
      --ink:#15202a;--ink-soft:#4a5a64;--line:#c9d2d8;--line-strong:#b3bec6;
      --accent:#1f5f88;--accent-ink:#184b6c;--accent-soft:#e6eef4;
      --warn:#8a5208;--warn-soft:#f4ead6;--tip:#276b55;--tip-soft:#e2efe9;
      --todo:#7a5000;--todo-soft:#f7eed6;
      --shadow:none;
    }
    @page{size:A4;margin:16mm 14mm;}
    body{background:#fff;}
    .wrap{max-width:none;padding:0;}
    .no-print{display:none !important;}
    .cover{page-break-after:always;box-shadow:none;}
    .section{page-break-before:always;margin-top:0;}
    .section:first-of-type{page-break-before:avoid;}
    .steps>li,.note,.shot,table.deco tr{page-break-inside:avoid;}
    .shot__box{aspect-ratio:auto;height:120px;}
    .shot__img{max-height:90mm;width:auto;margin:0 auto;}
  }
</style>

<div class="wrap">

  <div class="memo no-print" role="note">
    <h2>編集メモ（この枠は印刷されません）</h2>
